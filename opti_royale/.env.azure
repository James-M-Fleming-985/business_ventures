# Azure Production Environment Configuration

# Application Settings
NODE_ENV=production
PORT=80

# Azure Database for PostgreSQL Flexible Server
AZURE_POSTGRES_CONNECTION_STRING=postgresql://username:password@servername.postgres.database.azure.com:5432/opti_royale?sslmode=require
DATABASE_URL=${AZURE_POSTGRES_CONNECTION_STRING}
DATABASE_POOL_MIN=10
DATABASE_POOL_MAX=100
DATABASE_TIMEOUT=30000

# Azure Cache for Redis Premium (6GB+)
AZURE_REDIS_CONNECTION_STRING=rediss://cachename.redis.cache.windows.net:6380,password=yourkey,ssl=True,abortConnect=False
REDIS_URL=${AZURE_REDIS_CONNECTION_STRING}
REDIS_CLUSTER_ENABLED=true

# Azure Blob Storage for Video Files
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=account;AccountKey=key;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=clash-royale-videos
AZURE_CDN_ENDPOINT=https://yourcdn.azureedge.net

# Azure Computer Vision Service
AZURE_COMPUTER_VISION_ENDPOINT=https://region.cognitiveservices.azure.com/
AZURE_COMPUTER_VISION_KEY=your_cognitive_services_key

# Azure Machine Learning
AZURE_ML_WORKSPACE=your-ml-workspace
AZURE_ML_SUBSCRIPTION_ID=your-subscription-id
AZURE_ML_RESOURCE_GROUP=your-resource-group

# Azure Application Insights
AZURE_APPLICATION_INSIGHTS_CONNECTION_STRING=InstrumentationKey=key;IngestionEndpoint=https://region.in.applicationinsights.azure.com/

# JWT Configuration
JWT_SECRET=${AZURE_KEY_VAULT_JWT_SECRET}
JWT_EXPIRES_IN=7d

# Stripe Configuration
STRIPE_SECRET_KEY=${AZURE_KEY_VAULT_STRIPE_SECRET}
STRIPE_WEBHOOK_SECRET=${AZURE_KEY_VAULT_STRIPE_WEBHOOK}

# Performance Tuning - Enterprise Scale
MAX_CONCURRENT_ANALYSES=1000
CONCURRENT_CV_WORKERS=100
VIDEO_PROCESSING_TIMEOUT=300
BATCH_PROCESSING_SIZE=50
CACHE_TTL=1800
API_RATE_LIMIT=5000
UPLOAD_SIZE_LIMIT=1GB
GPU_INSTANCES_MIN=10
GPU_INSTANCES_MAX=50
CPU_INSTANCES_MIN=20
CPU_INSTANCES_MAX=100

# Azure Service Bus (for high-throughput messaging)
AZURE_SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://namespace.servicebus.windows.net/;SharedAccessKeyName=key;SharedAccessKey=value

# Azure Event Hub (for real-time analytics)
AZURE_EVENT_HUB_CONNECTION_STRING=Endpoint=sb://namespace.servicebus.windows.net/;SharedAccessKeyName=key;SharedAccessKey=value

# High Availability Settings
ENABLE_HEALTH_CHECKS=true
HEALTH_CHECK_INTERVAL=30
CIRCUIT_BREAKER_ENABLED=true
RETRY_ATTEMPTS=3
BACKOFF_MULTIPLIER=2

# Monitoring & Logging
LOG_LEVEL=info
ENABLE_METRICS=true
METRICS_PORT=9090
TRACE_SAMPLING_RATE=0.1

# Security
ENABLE_CORS=true
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=1000

# GPU Configuration for CV Service
CUDA_VISIBLE_DEVICES=0,1,2,3
OMP_NUM_THREADS=8
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility
