{
  "name": "@opti-royale/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:watch": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:migrate:ml": "psql $DATABASE_URL -f prisma/ml-schema.sql",
    "db:migrate:gamification": "psql $DATABASE_URL -f prisma/gamification-schema.sql",
    "sync:cards": "node dist/scripts/sync-cards.js",
    "sync:balance": "node dist/scripts/sync-balance-changes.js",
    "leaderboard:update": "node dist/scripts/update-leaderboards.js",
    "achievements:check": "node dist/scripts/check-achievements.js",
    "ml:train": "python ../ml-pipeline/train_model.py",
    "ml:deploy": "python ../ml-pipeline/deploy_model.py",
    "benchmark": "autocannon -c 100 -d 30 http://localhost:3001/health"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.450.0",
    "@aws-sdk/s3-request-presigner": "^3.450.0",
    "@azure/search-documents": "^12.0.0",
    "@azure/storage-blob": "^12.18.0",
    "@fastify/cors": "^8.4.0",
    "@fastify/helmet": "^11.1.0",
    "@fastify/jwt": "^7.2.0",
    "@fastify/multipart": "^8.0.0",
    "@fastify/rate-limit": "^8.0.0",
    "@fastify/redis": "^6.1.0",
    "@fastify/schedule": "^4.0.0",
    "@fastify/websocket": "^8.3.0",
    "@prisma/client": "^5.22.0",
    "aws-sdk": "^2.1489.0",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.0",
    "bullmq": "^4.15.0",
    "cluster": "^0.7.7",
    "compression": "^1.7.0",
    "date-fns": "^2.30.0",
    "dotenv": "^16.3.0",
    "elo-rating": "^1.0.0",
    "fastify": "^4.24.0",
    "ioredis": "^5.3.0",
    "lodash": "^4.17.0",
    "ml-matrix": "^6.10.0",
    "node-cache": "^5.1.0",
    "node-cron": "^3.0.0",
    "nodemailer": "^6.9.0",
    "os": "^0.1.2",
    "pg": "^8.11.0",
    "pg-pool": "^3.6.0",
    "pino": "^8.16.0",
    "pino-pretty": "^10.2.0",
    "prisma": "^5.22.0",
    "sharp": "^0.32.0",
    "simple-statistics": "^7.8.0",
    "stripe": "^14.0.0",
    "uuid": "^9.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.0",
    "@types/compression": "^1.7.0",
    "@types/jest": "^29.0.0",
    "@types/lodash": "^4.17.20",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^2.0.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "nodemon": "^3.1.10",
    "pino-pretty": "^10.2.0",
    "supertest": "^6.3.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
