# Gamification and Clash Royale API Integration

# Clash Royale API Integration
CLASH_ROYALE_API_TOKEN=your_clash_royale_api_token
CLASH_ROYALE_API_BASE_URL=https://api.clashroyale.com/v1
CARD_BALANCE_SYNC_INTERVAL=3600  # Check for updates every hour
CARD_METADATA_CACHE_TTL=86400    # Cache card data for 24 hours

# Gamification Settings
RANKING_SYSTEM_ENABLED=true
LEADERBOARD_UPDATE_INTERVAL=300  # Update leaderboards every 5 minutes
ACHIEVEMENT_NOTIFICATIONS=true
WEEKLY_CHALLENGES_ENABLED=true
SEASONAL_EVENTS_ENABLED=true

# Ranking System Configuration
RANKING_ALGORITHM=elo_modified    # elo_modified, percentile, skill_based
PLACEMENT_ACCURACY_WEIGHT=0.4     # 40% weight on placement accuracy
IMPROVEMENT_RATE_WEIGHT=0.3       # 30% weight on improvement over time
CONSISTENCY_WEIGHT=0.2            # 20% weight on consistency
DIFFICULTY_BONUS_WEIGHT=0.1       # 10% weight for analyzing difficult scenarios

# XP and Progression System
BASE_XP_PER_ANALYSIS=10
ACCURACY_BONUS_MULTIPLIER=2.0     # 2x XP for 90%+ accuracy
STREAK_BONUS_ENABLED=true
DAILY_BONUS_XP=50
WEEKLY_CHALLENGE_XP=500
PERFECT_PLACEMENT_XP=100

# Social Features
PUBLIC_LEADERBOARDS=true
GUILD_SYSTEM_ENABLED=true
CLAN_INTEGRATION=true             # Link with user's Clash Royale clan
FRIEND_CHALLENGES=true
ANALYSIS_SHARING=true

# Badge and Achievement System
ACHIEVEMENT_CATEGORIES=placement,improvement,consistency,social,special
BADGE_TIERS=bronze,silver,gold,platinum,diamond,legend
SEASONAL_BADGE_RESET=true

# Competition and Events
WEEKLY_TOURNAMENTS=true
MONTHLY_CHAMPIONSHIPS=true
PRIZE_POOL_ENABLED=false          # Set to true for real rewards
VIRTUAL_REWARDS_ENABLED=true      # In-app cosmetics, titles, etc.

# Card Balance Tracking
TRACK_META_SHIFTS=true
HISTORICAL_BALANCE_DATA=true
BALANCE_IMPACT_ANALYSIS=true
AUTO_MODEL_RETRAIN_ON_BALANCE=true

# Push Notifications
RANK_UP_NOTIFICATIONS=true
ACHIEVEMENT_NOTIFICATIONS=true
BALANCE_UPDATE_NOTIFICATIONS=true
WEEKLY_SUMMARY_NOTIFICATIONS=true
