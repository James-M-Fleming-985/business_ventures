/**
 * Amplitude Event Tracking
 * 
 * Generated by: tpl-analytics-amplitude
 * App: {{ app_name }}
 * 
 * Usage:
 *   import { trackEvent, identifyUser } from './analytics/amplitude-events';
 *   trackEvent('button_clicked', { button_name: 'signup' });
 *   identifyUser('user123', { email: 'user@example.com' });
 */

import * as amplitude from '@amplitude/analytics-browser';
import { isAmplitudeReady, setUserId as setAmplitudeUserId } from './amplitude-config';

/**
 * Track a custom event
 * 
 * @param {string} eventName - Name of the event
 * @param {object} properties - Additional properties
 */
export function trackEvent(eventName, properties = {}) {
  if (!isAmplitudeReady()) {
    console.warn(`Amplitude: Cannot track event '${eventName}' - not initialized`);
    return;
  }

  amplitude.track(eventName, {
    ...properties,
    timestamp: new Date().toISOString(),
  });

  if (import.meta.env.DEV) {
    console.log(`📊 Amplitude Event: ${eventName}`, properties);
  }
}

/**
 * Track a pageview
 * 
 * @param {string} pagePath - Page path
 * @param {object} properties - Additional properties
 */
export function trackPageview(pagePath, properties = {}) {
  trackEvent('[Amplitude] Page Viewed', {
    page_path: pagePath,
    page_title: document.title,
    ...properties,
  });
}

/**
 * Identify a user
 * 
 * @param {string} userId - Unique user ID
 * @param {object} properties - User properties
 */
export function identifyUser(userId, properties = {}) {
  if (!isAmplitudeReady()) {
    return;
  }

  // Set user ID
  setAmplitudeUserId(userId);
  
  // Set user properties
  if (Object.keys(properties).length > 0) {
    const identifyEvent = new amplitude.Identify();
    
    for (const [key, value] of Object.entries(properties)) {
      identifyEvent.set(key, value);
    }
    
    amplitude.identify(identifyEvent);
  }

  if (import.meta.env.DEV) {
    console.log(`👤 Amplitude User Identified: ${userId}`, properties);
  }
}

/**
 * Set user properties
 * 
 * @param {object} properties - Properties to set/update
 */
export function setUserProperties(properties) {
  if (!isAmplitudeReady()) {
    return;
  }

  const identifyEvent = new amplitude.Identify();
  
  for (const [key, value] of Object.entries(properties)) {
    identifyEvent.set(key, value);
  }
  
  amplitude.identify(identifyEvent);
}

/**
 * Increment a user property
 * 
 * @param {string} property - Property name
 * @param {number} value - Increment amount (default: 1)
 */
export function incrementProperty(property, value = 1) {
  if (!isAmplitudeReady()) {
    return;
  }

  const identifyEvent = new amplitude.Identify();
  identifyEvent.add(property, value);
  amplitude.identify(identifyEvent);
}

/**
 * Track revenue
 * 
 * @param {number} amount - Revenue amount
 * @param {string} productId - Product ID (optional)
 * @param {object} properties - Additional properties
 */
export function trackRevenue(amount, productId = null, properties = {}) {
  if (!isAmplitudeReady()) {
    return;
  }

  const revenue = new amplitude.Revenue()
    .setPrice(amount)
    .setQuantity(1);
  
  if (productId) {
    revenue.setProductId(productId);
  }
  
  for (const [key, value] of Object.entries(properties)) {
    revenue.setEventProperties({ ...properties });
  }
  
  amplitude.revenue(revenue);

  if (import.meta.env.DEV) {
    console.log(`💰 Amplitude Revenue: $${amount}`, { productId, ...properties });
  }
}

// Pre-defined event trackers
export const AmplitudeEvents = {
  // User lifecycle
  signupStarted: (method) => trackEvent('signup_started', { method }),
  signupCompleted: (method) => {
    trackEvent('signup_completed', { method });
    incrementProperty('signup_count');
  },
  loginSuccess: (method) => {
    trackEvent('login_success', { method });
    incrementProperty('login_count');
  },
  logoutSuccess: () => trackEvent('logout_success'),
  
  // Engagement
  buttonClicked: (buttonName, location) => 
    trackEvent('button_clicked', { button_name: buttonName, location }),
  
  linkClicked: (linkUrl, linkText) => 
    trackEvent('link_clicked', { link_url: linkUrl, link_text: linkText }),
  
  formSubmitted: (formName, formData = {}) => 
    trackEvent('form_submitted', { form_name: formName, ...formData }),
  
  formAbandoned: (formName, completedFields) => 
    trackEvent('form_abandoned', { 
      form_name: formName, 
      completed_fields: completedFields 
    }),
  
  // Email capture
  emailCaptured: (source) => {
    trackEvent('email_captured', { source });
    setUserProperties({ email_captured: true });
  },
  
  emailVerified: () => {
    trackEvent('email_verified');
    setUserProperties({ email_verified: true });
  },
  
  // Content engagement
  videoPlayed: (videoId, videoTitle) => 
    trackEvent('video_played', { video_id: videoId, video_title: videoTitle }),
  
  videoCompleted: (videoId, duration) => 
    trackEvent('video_completed', { video_id: videoId, duration_seconds: duration }),
  
  articleRead: (articleId, articleTitle, readTime) => 
    trackEvent('article_read', { 
      article_id: articleId, 
      article_title: articleTitle,
      read_time_seconds: readTime
    }),
  
  searchPerformed: (query, resultsCount) => 
    trackEvent('search_performed', { query, results_count: resultsCount }),
  
  // Feature usage
  featureUsed: (featureName, context = {}) => {
    trackEvent('feature_used', { feature_name: featureName, ...context });
    incrementProperty(`${featureName}_usage_count`);
  },
  
  featureViewed: (featureName) => 
    trackEvent('feature_viewed', { feature_name: featureName }),
  
  // E-commerce
  productViewed: (productId, productName, price, category) => 
    trackEvent('product_viewed', { 
      product_id: productId, 
      product_name: productName, 
      price,
      category
    }),
  
  addedToCart: (productId, productName, price, quantity = 1) => 
    trackEvent('added_to_cart', { 
      product_id: productId, 
      product_name: productName, 
      price,
      quantity,
      cart_total: price * quantity
    }),
  
  removedFromCart: (productId, productName) => 
    trackEvent('removed_from_cart', { 
      product_id: productId, 
      product_name: productName 
    }),
  
  checkoutStarted: (cartValue, itemCount, items = []) => 
    trackEvent('checkout_started', { 
      cart_value: cartValue, 
      item_count: itemCount,
      items
    }),
  
  checkoutCompleted: (transactionId, amount, items = []) => {
    trackEvent('checkout_completed', { 
      transaction_id: transactionId, 
      amount,
      items
    });
    trackRevenue(amount, null, { transaction_id: transactionId, items });
  },
  
  // Subscription/SaaS
  trialStarted: (planName, trialDays) => 
    trackEvent('trial_started', { plan_name: planName, trial_days: trialDays }),
  
  subscribed: (planName, amount, billingPeriod) => {
    trackEvent('subscribed', { 
      plan_name: planName, 
      amount,
      billing_period: billingPeriod
    });
    setUserProperties({ 
      subscription_plan: planName,
      is_subscriber: true
    });
  },
  
  unsubscribed: (planName, reason) => {
    trackEvent('unsubscribed', { plan_name: planName, reason });
    setUserProperties({ 
      is_subscriber: false,
      unsubscribe_reason: reason
    });
  },
  
  planUpgraded: (fromPlan, toPlan) => 
    trackEvent('plan_upgraded', { from_plan: fromPlan, to_plan: toPlan }),
  
  planDowngraded: (fromPlan, toPlan, reason) => 
    trackEvent('plan_downgraded', { 
      from_plan: fromPlan, 
      to_plan: toPlan,
      reason
    }),
  
  // Errors
  errorOccurred: (errorMessage, errorCode, context) => 
    trackEvent('error_occurred', { 
      error_message: errorMessage, 
      error_code: errorCode, 
      context 
    }),
};

/**
 * Track an experiment exposure
 * 
 * @param {string} experimentKey - Experiment identifier
 * @param {string} variant - Variant/group name
 */
export function trackExperiment(experimentKey, variant) {
  trackEvent('[Amplitude] Experiment Viewed', {
    experiment_key: experimentKey,
    variant: variant,
  });
  
  // Also set as user property
  setUserProperties({
    [`exp_${experimentKey}`]: variant,
  });
}
