/**
 * Amplitude Analytics Configuration
 * 
 * Generated by: tpl-analytics-amplitude
 * App: {{ app_name }}
 * Environment: {{ environment }}
 */

import * as amplitude from '@amplitude/analytics-browser';

// Amplitude API Key (from environment variable)
export const AMPLITUDE_API_KEY = import.meta.env.VITE_AMPLITUDE_API_KEY || '{{ api_key }}';
export const AMPLITUDE_DEBUG = {{ 'true' if enable_debug else 'false' }};
export const APP_NAME = '{{ app_name }}';
export const ENVIRONMENT = '{{ environment }}';

let isInitialized = false;

/**
 * Initialize Amplitude
 * Call this once in your app entry point (main.tsx or App.tsx)
 */
export function initializeAmplitude() {
  // Only initialize in browser environment
  if (typeof window === 'undefined') {
    return;
  }

  // Check if API key is configured
  if (!AMPLITUDE_API_KEY || AMPLITUDE_API_KEY.length < 10) {
    console.warn('Amplitude: API key not configured. Tracking disabled.');
    return;
  }

  // Avoid double initialization
  if (isInitialized) {
    return;
  }

  // Initialize Amplitude
  amplitude.init(AMPLITUDE_API_KEY, undefined, {
    logLevel: AMPLITUDE_DEBUG ? amplitude.Types.LogLevel.Debug : amplitude.Types.LogLevel.Warn,
    defaultTracking: {
      sessions: {{ 'true' if track_sessions else 'false' }},
      pageViews: true,
      formInteractions: false,
      fileDownloads: false,
    },
    {% if save_events %}
    offline: amplitude.Types.OfflineMode.PreferPersisted,
    {% endif %}
  });

  // Set user properties that apply to all events
  const identifyEvent = new amplitude.Identify();
  identifyEvent.set('app_name', APP_NAME);
  identifyEvent.set('environment', ENVIRONMENT);
  amplitude.identify(identifyEvent);

  isInitialized = true;
  console.log(`✅ Amplitude initialized: ${AMPLITUDE_API_KEY.substring(0, 8)}...`);
}

/**
 * Check if Amplitude is loaded and ready
 */
export function isAmplitudeReady() {
  return isInitialized;
}

/**
 * Get Amplitude SDK instance
 */
export function getAmplitude() {
  return amplitude;
}

/**
 * Get current device ID
 */
export function getDeviceId() {
  return amplitude.getDeviceId();
}

/**
 * Get current session ID
 */
export function getSessionId() {
  return amplitude.getSessionId();
}

/**
 * Reset Amplitude (logout)
 */
export function resetAmplitude() {
  amplitude.reset();
}

/**
 * Set user ID
 */
export function setUserId(userId) {
  amplitude.setUserId(userId);
}
