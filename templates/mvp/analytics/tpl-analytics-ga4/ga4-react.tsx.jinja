/**
 * Google Analytics 4 React Integration
 * 
 * Generated by: tpl-analytics-ga4
 * App: {{ app_name }}
 * 
 * Usage in React:
 *   import { GAProvider, useGA } from './analytics/ga4-react';
 *   
 *   // Wrap your app
 *   <GAProvider>
 *     <App />
 *   </GAProvider>
 *   
 *   // Use in components
 *   const { trackEvent } = useGA();
 *   trackEvent('button_click', { button_name: 'signup' });
 */

import React, { createContext, useContext, useEffect } from 'react';
import { useLocation } from 'react-router-dom';
import { initializeGA4 } from './ga4-config';
import { trackPageview, trackEvent, GAEvents } from './ga4-events';

interface GAContextType {
  trackEvent: typeof trackEvent;
  trackPageview: typeof trackPageview;
  events: typeof GAEvents;
}

const GAContext = createContext<GAContextType | null>(null);

/**
 * GA4 Provider Component
 * Initializes GA4 and provides tracking functions via context
 */
export function GAProvider({ children }: { children: React.ReactNode }) {
  useEffect(() => {
    // Initialize GA4 on mount
    initializeGA4();
  }, []);

  const value: GAContextType = {
    trackEvent,
    trackPageview,
    events: GAEvents,
  };

  return <GAContext.Provider value={value}>{children}</GAContext.Provider>;
}

/**
 * Hook to access GA4 tracking functions
 */
export function useGA(): GAContextType {
  const context = useContext(GAContext);
  if (!context) {
    throw new Error('useGA must be used within GAProvider');
  }
  return context;
}

/**
 * Component to auto-track pageviews with React Router
 * Place this inside your Router component
 */
export function GAPageviewTracker() {
  const location = useLocation();

  useEffect(() => {
    // Track pageview on route change
    trackPageview(location.pathname + location.search);
  }, [location]);

  return null;
}

/**
 * HOC to track component mount/unmount
 */
export function withGATracking<P extends object>(
  Component: React.ComponentType<P>,
  componentName: string
) {
  return function GATrackedComponent(props: P) {
    useEffect(() => {
      trackEvent('component_view', { component_name: componentName });

      return () => {
        trackEvent('component_unmount', { component_name: componentName });
      };
    }, []);

    return <Component {...props} />;
  };
}

/**
 * Component to track button clicks
 */
interface GAButtonProps extends React.ButtonHTMLAttributes<HTMLButtonElement> {
  eventName?: string;
  eventParams?: Record<string, any>;
  children: React.ReactNode;
}

export function GAButton({ 
  eventName = 'button_click', 
  eventParams = {}, 
  onClick,
  children,
  ...props 
}: GAButtonProps) {
  const handleClick = (e: React.MouseEvent<HTMLButtonElement>) => {
    trackEvent(eventName, eventParams);
    onClick?.(e);
  };

  return (
    <button onClick={handleClick} {...props}>
      {children}
    </button>
  );
}

/**
 * Component to track link clicks
 */
interface GALinkProps extends React.AnchorHTMLAttributes<HTMLAnchorElement> {
  eventParams?: Record<string, any>;
  children: React.ReactNode;
}

export function GALink({ 
  eventParams = {}, 
  onClick,
  href,
  children,
  ...props 
}: GALinkProps) {
  const handleClick = (e: React.MouseEvent<HTMLAnchorElement>) => {
    trackEvent('link_click', { link_url: href, ...eventParams });
    onClick?.(e);
  };

  return (
    <a href={href} onClick={handleClick} {...props}>
      {children}
    </a>
  );
}
