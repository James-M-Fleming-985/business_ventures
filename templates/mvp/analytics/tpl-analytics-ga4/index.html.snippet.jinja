<!-- 
  Google Analytics 4 Tracking Code
  Generated by: tpl-analytics-ga4
  App: {{ app_name }}
  
  INSTRUCTIONS:
  1. Add this snippet to your <head> tag in index.html
  2. Replace {{ measurement_id }} with your actual GA4 Measurement ID
  3. Or use environment variable: VITE_GA4_MEASUREMENT_ID
-->

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id={{ measurement_id }}"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', '{{ measurement_id }}', {
    'app_name': '{{ app_name }}',
    'debug_mode': {{ 'true' if enable_debug else 'false' }},
    'send_page_view': true
  });
</script>
