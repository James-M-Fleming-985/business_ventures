/**
 * Google Analytics 4 Event Tracking
 * 
 * Generated by: tpl-analytics-ga4
 * App: {{ app_name }}
 * 
 * Usage:
 *   import { trackEvent, trackPageview } from './analytics/ga4-events';
 *   trackEvent('button_click', { button_name: 'signup' });
 */

import { isGA4Ready } from './ga4-config';

/**
 * Track a custom event
 * 
 * @param {string} eventName - Name of the event (e.g., 'button_click')
 * @param {object} eventParams - Additional parameters
 */
export function trackEvent(eventName, eventParams = {}) {
  if (!isGA4Ready()) {
    console.warn(`GA4: Cannot track event '${eventName}' - GA4 not initialized`);
    return;
  }

  window.gtag('event', eventName, {
    ...eventParams,
    timestamp: new Date().toISOString(),
  });

  if (import.meta.env.DEV) {
    console.log(`📊 GA4 Event: ${eventName}`, eventParams);
  }
}

/**
 * Track a pageview
 * 
 * @param {string} pagePath - Page path (e.g., '/pricing')
 * @param {string} pageTitle - Page title (optional)
 */
export function trackPageview(pagePath, pageTitle = document.title) {
  if (!isGA4Ready()) {
    return;
  }

  window.gtag('event', 'page_view', {
    page_path: pagePath,
    page_title: pageTitle,
  });

  if (import.meta.env.DEV) {
    console.log(`📊 GA4 Pageview: ${pagePath}`);
  }
}

/**
 * Track a conversion event
 * 
 * @param {string} conversionName - Conversion event name
 * @param {number} value - Conversion value (optional)
 */
export function trackConversion(conversionName, value = null) {
  const params = {};
  if (value !== null) {
    params.value = value;
    params.currency = 'USD';
  }

  trackEvent(conversionName, params);
}

// Pre-defined event trackers
export const GAEvents = {
  // User interactions
  buttonClick: (buttonName) => trackEvent('button_click', { button_name: buttonName }),
  linkClick: (linkUrl) => trackEvent('link_click', { link_url: linkUrl }),
  formSubmit: (formName) => trackEvent('form_submit', { form_name: formName }),
  
  // Email capture
  emailCapture: (source) => trackEvent('email_capture', { source }),
  emailCaptureSuccess: (source) => trackEvent('email_capture_success', { source }),
  emailCaptureFailed: (source, error) => trackEvent('email_capture_failed', { source, error }),
  
  // Authentication
  signupStart: () => trackEvent('signup_start'),
  signupComplete: () => trackConversion('signup_complete'),
  loginSuccess: () => trackEvent('login_success'),
  logoutSuccess: () => trackEvent('logout_success'),
  
  // Engagement
  videoPlay: (videoId) => trackEvent('video_play', { video_id: videoId }),
  downloadStart: (fileName) => trackEvent('download_start', { file_name: fileName }),
  shareContent: (contentType) => trackEvent('share_content', { content_type: contentType }),
  
  // E-commerce (if applicable)
  viewItem: (itemId, itemName) => trackEvent('view_item', { item_id: itemId, item_name: itemName }),
  addToCart: (itemId, itemName, price) => trackEvent('add_to_cart', { 
    item_id: itemId, 
    item_name: itemName,
    value: price,
    currency: 'USD'
  }),
  beginCheckout: (value) => trackEvent('begin_checkout', { value, currency: 'USD' }),
  purchase: (transactionId, value) => trackConversion('purchase', value),
  
{% if custom_events %}
  // Custom events
{% for event in custom_events %}
  {{ event }}: (params = {}) => trackEvent('{{ event }}', params),
{% endfor %}
{% endif %}
};

/**
 * Track errors/exceptions
 */
export function trackError(errorMessage, fatal = false) {
  trackEvent('exception', {
    description: errorMessage,
    fatal: fatal,
  });
}

/**
 * Track timing/performance
 */
export function trackTiming(name, value, category = 'performance') {
  trackEvent('timing_complete', {
    name: name,
    value: Math.round(value),
    event_category: category,
  });
}

/**
 * Set user properties
 */
export function setUserProperties(properties) {
  if (!isGA4Ready()) {
    return;
  }

  window.gtag('set', 'user_properties', properties);
}

/**
 * Set user ID (for cross-device tracking)
 */
export function setUserId(userId) {
  if (!isGA4Ready()) {
    return;
  }

  window.gtag('set', { user_id: userId });
}
