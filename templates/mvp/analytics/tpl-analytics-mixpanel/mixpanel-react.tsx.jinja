/**
 * Mixpanel React Integration
 * 
 * Generated by: tpl-analytics-mixpanel
 * App: {{ app_name }}
 * 
 * Usage in React:
 *   import { MixpanelProvider, useMixpanel } from './analytics/mixpanel-react';
 *   
 *   // Wrap your app
 *   <MixpanelProvider>
 *     <App />
 *   </MixpanelProvider>
 *   
 *   // Use in components
 *   const { trackEvent } = useMixpanel();
 *   trackEvent('Button Clicked', { button_name: 'signup' });
 */

import React, { createContext, useContext, useEffect } from 'react';
import { useLocation } from 'react-router-dom';
import { initializeMixpanel } from './mixpanel-config';
import { 
  trackEvent, 
  trackPageview, 
  identifyUser,
  setUserProperties,
  MixpanelEvents 
} from './mixpanel-events';

interface MixpanelContextType {
  trackEvent: typeof trackEvent;
  trackPageview: typeof trackPageview;
  identifyUser: typeof identifyUser;
  setUserProperties: typeof setUserProperties;
  events: typeof MixpanelEvents;
}

const MixpanelContext = createContext<MixpanelContextType | null>(null);

/**
 * Mixpanel Provider Component
 * Initializes Mixpanel and provides tracking functions via context
 */
export function MixpanelProvider({ children }: { children: React.ReactNode }) {
  useEffect(() => {
    // Initialize Mixpanel on mount
    initializeMixpanel();
  }, []);

  const value: MixpanelContextType = {
    trackEvent,
    trackPageview,
    identifyUser,
    setUserProperties,
    events: MixpanelEvents,
  };

  return <MixpanelContext.Provider value={value}>{children}</MixpanelContext.Provider>;
}

/**
 * Hook to access Mixpanel tracking functions
 */
export function useMixpanel(): MixpanelContextType {
  const context = useContext(MixpanelContext);
  if (!context) {
    throw new Error('useMixpanel must be used within MixpanelProvider');
  }
  return context;
}

/**
 * Component to auto-track pageviews with React Router
 * Place this inside your Router component
 */
export function MixpanelPageviewTracker() {
  const location = useLocation();

  useEffect(() => {
    // Track pageview on route change
    trackPageview(location.pathname + location.search);
  }, [location]);

  return null;
}

/**
 * HOC to track component views
 */
export function withMixpanelTracking<P extends object>(
  Component: React.ComponentType<P>,
  componentName: string
) {
  return function MixpanelTrackedComponent(props: P) {
    useEffect(() => {
      trackEvent('Component Viewed', { component_name: componentName });
    }, []);

    return <Component {...props} />;
  };
}

/**
 * Component to track button clicks
 */
interface MixpanelButtonProps extends React.ButtonHTMLAttributes<HTMLButtonElement> {
  eventName?: string;
  eventProperties?: Record<string, any>;
  children: React.ReactNode;
}

export function MixpanelButton({ 
  eventName = 'Button Clicked', 
  eventProperties = {}, 
  onClick,
  children,
  ...props 
}: MixpanelButtonProps) {
  const handleClick = (e: React.MouseEvent<HTMLButtonElement>) => {
    trackEvent(eventName, eventProperties);
    onClick?.(e);
  };

  return (
    <button onClick={handleClick} {...props}>
      {children}
    </button>
  );
}

/**
 * Component to track link clicks
 */
interface MixpanelLinkProps extends React.AnchorHTMLAttributes<HTMLAnchorElement> {
  eventProperties?: Record<string, any>;
  children: React.ReactNode;
}

export function MixpanelLink({ 
  eventProperties = {}, 
  onClick,
  href,
  children,
  ...props 
}: MixpanelLinkProps) {
  const handleClick = (e: React.MouseEvent<HTMLAnchorElement>) => {
    trackEvent('Link Clicked', { link_url: href, ...eventProperties });
    onClick?.(e);
  };

  return (
    <a href={href} onClick={handleClick} {...props}>
      {children}
    </a>
  );
}
