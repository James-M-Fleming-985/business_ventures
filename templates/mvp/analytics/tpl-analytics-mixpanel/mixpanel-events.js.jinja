/**
 * Mixpanel Event Tracking
 * 
 * Generated by: tpl-analytics-mixpanel
 * App: {{ app_name }}
 * 
 * Usage:
 *   import { trackEvent, identifyUser } from './analytics/mixpanel-events';
 *   trackEvent('Button Clicked', { button_name: 'signup' });
 *   identifyUser('user123', { email: 'user@example.com' });
 */

import { getMixpanel, isMixpanelReady } from './mixpanel-config';

/**
 * Track a custom event
 * 
 * @param {string} eventName - Name of the event
 * @param {object} properties - Additional properties
 */
export function trackEvent(eventName, properties = {}) {
  if (!isMixpanelReady()) {
    console.warn(`Mixpanel: Cannot track event '${eventName}' - not initialized`);
    return;
  }

  const mp = getMixpanel();
  mp.track(eventName, {
    ...properties,
    timestamp: new Date().toISOString(),
  });

  if (import.meta.env.DEV) {
    console.log(`📊 Mixpanel Event: ${eventName}`, properties);
  }
}

/**
 * Track a pageview
 * 
 * @param {string} pagePath - Page path
 * @param {object} properties - Additional properties
 */
export function trackPageview(pagePath, properties = {}) {
  trackEvent('Page Viewed', {
    page_path: pagePath,
    page_title: document.title,
    ...properties,
  });
}

/**
 * Identify a user
 * 
 * @param {string} userId - Unique user ID
 * @param {object} properties - User properties
 */
export function identifyUser(userId, properties = {}) {
  if (!isMixpanelReady()) {
    return;
  }

  const mp = getMixpanel();
  
  // Identify the user
  mp.identify(userId);
  
  // Set user properties (one-time set)
  if (Object.keys(properties).length > 0) {
    mp.people.set(properties);
  }

  if (import.meta.env.DEV) {
    console.log(`👤 Mixpanel User Identified: ${userId}`, properties);
  }
}

/**
 * Set user properties (can be called multiple times)
 * 
 * @param {object} properties - Properties to set/update
 */
export function setUserProperties(properties) {
  if (!isMixpanelReady()) {
    return;
  }

  const mp = getMixpanel();
  mp.people.set(properties);
}

/**
 * Increment a user property (e.g., login_count)
 * 
 * @param {string} property - Property name
 * @param {number} value - Increment amount (default: 1)
 */
export function incrementProperty(property, value = 1) {
  if (!isMixpanelReady()) {
    return;
  }

  const mp = getMixpanel();
  mp.people.increment(property, value);
}

/**
 * Track revenue/charge
 * 
 * @param {number} amount - Transaction amount
 * @param {object} properties - Additional transaction properties
 */
export function trackRevenue(amount, properties = {}) {
  if (!isMixpanelReady()) {
    return;
  }

  const mp = getMixpanel();
  mp.people.track_charge(amount, {
    ...properties,
    $time: new Date().toISOString(),
  });

  trackEvent('Revenue', {
    amount: amount,
    ...properties,
  });
}

// Pre-defined event trackers
export const MixpanelEvents = {
  // User lifecycle
  signupStarted: () => trackEvent('Signup Started'),
  signupCompleted: (method) => {
    trackEvent('Signup Completed', { method });
    incrementProperty('signup_count');
  },
  loginSuccess: (method) => {
    trackEvent('Login Success', { method });
    incrementProperty('login_count');
  },
  logoutSuccess: () => trackEvent('Logout Success'),
  
  // Engagement
  buttonClicked: (buttonName, location) => 
    trackEvent('Button Clicked', { button_name: buttonName, location }),
  
  linkClicked: (linkUrl, linkText) => 
    trackEvent('Link Clicked', { link_url: linkUrl, link_text: linkText }),
  
  formSubmitted: (formName, formData = {}) => 
    trackEvent('Form Submitted', { form_name: formName, ...formData }),
  
  formError: (formName, errorField, errorMessage) => 
    trackEvent('Form Error', { 
      form_name: formName, 
      error_field: errorField, 
      error_message: errorMessage 
    }),
  
  // Email capture
  emailCaptured: (source) => {
    trackEvent('Email Captured', { source });
    setUserProperties({ email_captured: true });
  },
  
  // Content engagement
  videoPlayed: (videoId, videoTitle) => 
    trackEvent('Video Played', { video_id: videoId, video_title: videoTitle }),
  
  videoCompleted: (videoId, duration) => 
    trackEvent('Video Completed', { video_id: videoId, duration_seconds: duration }),
  
  downloadStarted: (fileName, fileType) => 
    trackEvent('Download Started', { file_name: fileName, file_type: fileType }),
  
  searchPerformed: (query, resultsCount) => 
    trackEvent('Search Performed', { query, results_count: resultsCount }),
  
  // Feature usage
  featureUsed: (featureName) => {
    trackEvent('Feature Used', { feature_name: featureName });
    incrementProperty(`${featureName}_count`);
  },
  
  // E-commerce
  productViewed: (productId, productName, price) => 
    trackEvent('Product Viewed', { 
      product_id: productId, 
      product_name: productName, 
      price 
    }),
  
  addedToCart: (productId, productName, price, quantity = 1) => 
    trackEvent('Added to Cart', { 
      product_id: productId, 
      product_name: productName, 
      price,
      quantity 
    }),
  
  checkoutStarted: (cartValue, itemCount) => 
    trackEvent('Checkout Started', { cart_value: cartValue, item_count: itemCount }),
  
  purchaseCompleted: (transactionId, amount, items) => {
    trackEvent('Purchase Completed', { 
      transaction_id: transactionId, 
      amount,
      items 
    });
    trackRevenue(amount, { transaction_id: transactionId });
  },
  
  // Errors
  errorOccurred: (errorMessage, errorCode, context) => 
    trackEvent('Error Occurred', { 
      error_message: errorMessage, 
      error_code: errorCode, 
      context 
    }),
};

/**
 * Create a funnel step tracker
 * 
 * @param {string} funnelName - Name of the funnel
 * @param {number} step - Step number
 * @param {object} properties - Additional properties
 */
export function trackFunnelStep(funnelName, step, properties = {}) {
  trackEvent(`${funnelName} - Step ${step}`, {
    funnel_name: funnelName,
    step_number: step,
    ...properties,
  });
}

/**
 * Start a timed event
 * 
 * @param {string} eventName - Event name to time
 */
export function startTimer(eventName) {
  if (!isMixpanelReady()) {
    return;
  }

  const mp = getMixpanel();
  mp.time_event(eventName);
}

/**
 * Track an event with duration (call startTimer first)
 * 
 * @param {string} eventName - Event name
 * @param {object} properties - Additional properties
 */
export function trackTimedEvent(eventName, properties = {}) {
  trackEvent(eventName, properties);
}
