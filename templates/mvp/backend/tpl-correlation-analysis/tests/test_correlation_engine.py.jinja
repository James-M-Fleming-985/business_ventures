    def test_handle_missing_data_interpolate(self):
        """Test missing data handling with interpolation."""
        data_with_nan = np.array([1.0, 2.0, np.nan, 4.0, 5.0])
        self.calculator.config.missing_data_strategy = 'interpolate'
        result = self.calculator._handle_missing_data(data_with_nan)
        assert not np.isnan(result).any()
        assert result[2] == 3.0  # Interpolated value
        
    def test_handle_missing_data_fill(self):
        """Test missing data handling with fill value."""
        data_with_nan = np.array([1.0, np.nan, 3.0])
        self.calculator.config.missing_data_strategy = 'fill'
        self.calculator.config.fill_value = -999.0
        result = self.calculator._handle_missing_data(data_with_nan)
        assert not np.isnan(result).any()
        assert result[1] == -999.0
        
    def test_handle_missing_data_drop(self):
        """Test missing data handling by dropping rows."""
        data_with_nan = np.array([[1.0, 2.0], [np.nan, 4.0], [5.0, 6.0]])
        self.calculator.config.missing_data_strategy = 'drop'
        result = self.calculator._handle_missing_data(data_with_nan)
        assert result.shape[0] == 2  # One row dropped
        assert not np.isnan(result).any()
        
    def test_normalize_data(self):
        """Test data normalization."""
        data = np.array([10, 20, 30, 40, 50])
        result = self.calculator._normalize_data(data)
        assert np.min(result) == 0.0
        assert np.max(result) == 1.0
        assert np.allclose(result, [0.0, 0.25, 0.5, 0.75, 1.0])
        
    def test_normalize_data_constant(self):
        """Test normalization with constant data."""
        data = np.array([5, 5, 5, 5, 5])
        result = self.calculator._normalize_data(data)
        assert np.all(result == 0.0)
        
