# Causal Affect Platform - Environment Variables Template
# Copy this file to .env and fill in your values

# ============================================================================
# APPLICATION
# ============================================================================
APP_NAME=causal-affect-platform
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# ============================================================================
# API CONFIGURATION
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2
API_RELOAD=false

# CORS Settings
CORS_ORIGINS=["https://yourdomain.com"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS"]
CORS_ALLOW_HEADERS=["*"]

# ============================================================================
# DATABASE
# ============================================================================
# PostgreSQL (Railway will inject DATABASE_URL automatically)
DATABASE_URL=${DATABASE_URL}
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ============================================================================
# REDIS CACHE
# ============================================================================
# Redis (Railway will inject REDIS_URL automatically)
REDIS_URL=${REDIS_URL}
CACHE_TTL=300
CACHE_ENABLED=true

# ============================================================================
# SECURITY
# ============================================================================
SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
ENCRYPTION_KEY=your-encryption-key-here-change-in-production

# ============================================================================
# FORECASTING CONFIGURATION (CA-003-01)
# ============================================================================
# Statistical Models
ENABLE_ARIMA=true
ENABLE_SARIMA=true
ENABLE_PROPHET=true
ENABLE_EXPONENTIAL_SMOOTHING=true

# ML Models  
ENABLE_XGBOOST=true
ENABLE_RANDOM_FOREST=true
ENABLE_LSTM=true

# Ensemble Settings
ENSEMBLE_METHOD=weighted_average
FORECAST_CONFIDENCE_LEVEL=0.95
FORECAST_DEFAULT_HORIZON=30
MAX_FORECAST_HORIZON=90

# Validation
VALIDATION_SPLIT=0.2
BACKTEST_PERIODS=5
MIN_ACCURACY_THRESHOLD=0.70

# ============================================================================
# MLFLOW TRACKING (CA-003-01 Layer 03)
# ============================================================================
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=causal-affect-forecasting
MLFLOW_ENABLE_AUTOLOG=true

# ============================================================================
# CORRELATION ANALYSIS (CA-002)
# ============================================================================
CORRELATION_MIN_THRESHOLD=0.3
CORRELATION_SIGNIFICANCE_LEVEL=0.05
CORRELATION_METHOD=pearson
MAX_CORRELATIONS_TO_ANALYZE=100

# ============================================================================
# NATURAL LANGUAGE GENERATION (CA-002-07)
# ============================================================================
NLG_STYLE=detailed
NLG_ENABLE_LAYPERSON_MODE=true
NLG_MAX_EXPLANATIONS_PER_REQUEST=10

# ============================================================================
# DRIFT DETECTION (CA-002-07 Layer 02)
# ============================================================================
DRIFT_DETECTION_ENABLED=true
DRIFT_THRESHOLD=0.05
DRIFT_WINDOW_SIZE=30
DRIFT_DETECTION_METHOD=ks_test

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
ENABLE_REQUEST_LOGGING=true
ENABLE_PERFORMANCE_METRICS=true

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ============================================================================
# EXTERNAL SERVICES
# ============================================================================
# Add any external API keys here
# WEATHER_API_KEY=
# FINANCIAL_DATA_API_KEY=

# ============================================================================
# AWS S3 STORAGE
# ============================================================================
# S3 Configuration (optional - for file uploads and backups)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-bucket-name
